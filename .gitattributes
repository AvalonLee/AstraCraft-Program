# 统一换行为 LF，防止 Windows 环境下 CRLF 污染 vendored 的上游文件。
# vendored 内容必须与上游逐字节一致，否则 upstream.lock 的 content_hash 会失配。
* text=auto eol=lf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary

# 自动生成的索引在 diff 中折叠显示，减少 review 噪音
INDEX.md linguist-generated=true

# vendored 源码不计入仓库语言统计，也不参与 GitHub 代码搜索排序
*/*/src/** linguist-vendored=true
