{
  "ignorePatterns": [
    { "pattern": "^https?://(localhost|127\\.0\\.0\\.1)" },
    { "pattern": "^https?://example\\.(com|org|net)" },
    { "pattern": "^https://github\\.com/OWNER/REPO" },
    { "pattern": "^mailto:" }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com", "https://raw.githubusercontent.com"],
      "headers": {
        "Accept": "text/html",
        "User-Agent": "Mozilla/5.0 (compatible; AstraCraftProgram-LinkCheck/1.0)"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 429]
}
