{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["record_type", "name", "description"],
  "properties": {
    "record_type": {"const": "installable-skill"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1}
  },
  "not": {
    "anyOf": [
      {"required": ["tier"]},
      {"required": ["metrics"]}
    ]
  }
}
