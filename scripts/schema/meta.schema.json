{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AvalonLee/SkillMall/scripts/schema/meta.schema.json",
  "title": "SkillMall SKILL.md Frontmatter",
  "description": "SkillMall 条目的元数据结构。每个条目由单个 SKILL.md 描述，元数据放在文件开头的 YAML frontmatter 中。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name_zh",
    "name_en",
    "summary_zh",
    "summary_en",
    "category",
    "kind",
    "tags",
    "languages",
    "license",
    "homepage",
    "repo",
    "tier",
    "added_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "全局唯一标识，必须等于所在目录名"
    },
    "name_zh": { "type": "string", "minLength": 1, "maxLength": 80 },
    "name_en": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary_zh": { "type": "string", "minLength": 8, "maxLength": 200 },
    "summary_en": { "type": "string", "minLength": 8, "maxLength": 200 },
    "category": {
      "type": "string",
      "enum": [
        "writing-docs", "dev-engineering", "design-creative", "data-analytics",
        "research-intel", "ops-automation", "business-office", "agent-infra",
        "dsh", "meta-skillcraft"
      ]
    },
    "kind": {
      "type": "string",
      "enum": ["skill", "skill-collection", "mcp-server", "cli-tool", "framework", "spec"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    },
    "languages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9+#.-]+$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "doc_languages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z]+)?$" },
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX 标识符，或 UNKNOWN / LicenseRef-xxx。仅供 Agent 判断是否可商用，本仓库不转载源码"
    },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "repo": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "docs_url": { "type": ["string", "null"], "pattern": "^https?://" },
    "tier": {
      "type": "string",
      "enum": ["core", "standard", "watch"],
      "description": "core=主推（有实测或公认优质） standard=常规 watch=观察期"
    },
    "featured": {
      "type": "boolean",
      "description": "是否入选首页「精选推荐」区。由维护者手工标注的少量高价值技能，与 tier 相互独立（观察期新条目也可被精选）。"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stars": { "type": ["integer", "null"], "minimum": 0 },
        "pushed_at": { "type": ["string", "null"] },
        "checked_at": { "type": ["string", "null"] },
        "archived": { "type": ["boolean", "null"] }
      }
    },
    "related": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "risk_notes": { "type": ["string", "null"] },
    "added_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
